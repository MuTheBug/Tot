# Binance USDT-M Futures API credentials
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Set to "true" to run against the Binance Futures testnet
BINANCE_TESTNET=true

# Telegram bot token (create via @BotFather) and your chat id
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Comma-separated list of USDT-M perp symbols to trade.
# Set to "AUTO" to automatically scan the top N symbols by 24h volume.
SYMBOLS=AUTO

# When SYMBOLS=AUTO, how many top-volume USDT-M perps to scan
TOP_VOLUME_COUNT=50

# Maximum concurrent open positions across all symbols.
# Default 1 = strict one-at-a-time mode. Increase to scan more setups.
MAX_OPEN_POSITIONS=1

# Trading timeframe (playbook uses 4h)
TIMEFRAME=4h

# Risk per trade as a fraction of wallet balance (0.01 = 1%)
RISK_PER_TRADE=0.01

# Max leverage. The bot will auto-scale leverage up (never above this cap)
# so that the trade meets the exchange min-notional even with small capital.
MAX_LEVERAGE=50

# Minimum leverage floor (exchange normally requires >= 1)
MIN_LEVERAGE=1

# Margin type: ISOLATED or CROSSED
MARGIN_TYPE=ISOLATED

# Pivot lookback (bars each side) used to confirm a swing high/low
PIVOT_LOOKBACK=3

# Touchpoint count requirements (A+ trendline = >= 3, break setups can use 2)
BOUNCE_MIN_TOUCHES=3
BREAK_MIN_TOUCHES=2

# Doc rule: minimum 6 candles between consecutive touchpoints.
MIN_BARS_BETWEEN_TAPS=6

# Doc rule: minimum 3 weeks of price data first-touch -> entry.
# 3 weeks on 4h = 126 bars.
MIN_BARS_FIRST_TO_END=126

# Doc rule: trendline slope must be < 45 degrees on a 3-month chart view.
# 3 months on 4h ≈ 540 bars.
MAX_SLOPE_DEG=45
SLOPE_REF_BARS=540

# Tolerance (fraction of price) for considering a pivot "on" the line.
TRENDLINE_TOLERANCE=0.0035

# Bounce stop "standard deviation" buffer beyond the line (fraction of price).
# Doc: stop must be given enough room so routine wicks do not trigger it.
BOUNCE_STOP_BUFFER=0.0015

# Break setup "4th candle rule": initial SL = safety line value at
# (entry_bar + N).  N=4 per the doc.
FOURTH_CANDLE_OFFSET=4

# Number of candles to fetch for analysis (>= MIN_BARS_FIRST_TO_END + buffer).
CANDLE_LIMIT=700

# Poll interval in seconds between market scans
POLL_INTERVAL=60

# Dry-run mode (true = no real orders, just alerts)
DRY_RUN=false
